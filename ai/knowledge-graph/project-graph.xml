<?xml version="1.0" encoding="UTF-8"?>
<project name="neuroglyphs" version="2.0" updated="2026-08-20">
  <description>
    NEUROGLYPHS v2 — endless generative kaleidoscope explorer.
    3D worlds made entirely of glyphs, formulas, and light.
    Seed = world. Music = heartbeat. No goal, no death.
  </description>

  <invariants>
    <invariant id="INV-1">No Math.random() for world generation — seeded PRNG only.</invariant>
    <invariant id="INV-2">All visuals are glyph-based (or shader effects on glyph geometry).</invariant>
    <invariant id="INV-3">One world = one seed. Same seed = same world (deterministic).</invariant>
    <invariant id="INV-4">No player death, no fail state.</invariant>
    <invariant id="INV-5">Music drives all pulsation/reactivity (built-in generator if no file).</invariant>
    <invariant id="INV-6">Exit is always rectangular, always findable.</invariant>
    <invariant id="INV-7">Deterministic: same seed + same collected things = same next world.</invariant>
    <invariant id="INV-8">No text in-world (tasks communicated visually/audibly).</invariant>
  </invariants>

  <modules>
    <module id="m-scaffold" file="index.html + src/main.js + server.js" status="done">
      <desc>Three.js r160 boot loop, import map, static server, render loop.</desc>
    </module>
    <module id="m-rng" file="src/core/rng.js" status="done">
      <desc>mulberry32 seeded PRNG, string→uint32 hash.</desc>
    </module>
    <module id="m-glyphs" file="src/core/glyphs.js" status="done">
      <desc>Glyph alphabet (symbols, formulas, CJK), palette, per-mood sets.</desc>
    </module>
    <module id="m-glyphtex" file="src/core/glyphTexture.js" status="done">
      <desc>Canvas texture atlas from glyph set + palette.</desc>
    </module>
    <module id="m-seed" file="src/core/seed.js" status="done">
      <desc>Seed encode/decode (base36 string), world params extraction.</desc>
    </module>
    <module id="m-worldgen" file="src/world/generator.js + src/world/structures.js" status="done">
      <desc>Seeded world generation: 8 structure layouts, particles, fog, exit portal. worldParams() is the single pure source of seed-driven decisions.</desc>
    </module>
    <module id="m-music" file="src/audio/musicEngine.js" status="todo">
      <desc>Web Audio: file load, FFT, tempo, mood, reactivity hooks.</desc>
    </module>
    <module id="m-reactor" file="src/world/visualReactor.js" status="todo">
      <desc>Music→visuals: pulsation, rim light, spectral, phase, echo.</desc>
    </module>
    <module id="m-movement" file="src/player/movement.js" status="todo">
      <desc>Fly-cam WASD+mouse, boost/slow, freeze/inspect mode.</desc>
    </module>
    <module id="m-transition" file="src/world/transition.js" status="todo">
      <desc>Exit portal, dissolve animation, re-seed, world book.</desc>
    </module>
    <module id="m-advanced" file="src/world/advancedVisuals.js" status="todo">
      <desc>Reflections, distortion, mercury, temporal echoes, matryoshka.</desc>
    </module>
    <module id="m-mood" file="src/world/moodSystem.js" status="todo">
      <desc>Mood palettes, behavior modifiers, atmosphere per mood.</desc>
    </module>
    <module id="m-neuro" file="src/world/neuroPrompt.js" status="todo">
      <desc>Text→LLM→JSON param tweaks (paid feature, stub for now).</desc>
    </module>
    <module id="m-seeds" file="src/world/curatedSeeds.js" status="todo">
      <desc>100 curated seeds, seed sharing, built-in generative music.</desc>
    </module>
    <module id="m-polish" file="src/ui/menu.js + src/ui/settings.js" status="todo">
      <desc>Menu, settings, audio upload, performance tuning.</desc>
    </module>
  </modules>

